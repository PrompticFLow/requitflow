# Database Setup
DATABASE_URL=

# Authentication & Security
# true = users must supply OpenRouter, NeverBounce, Apify, BayOfAssets, PDL, Twilio in Settings
IS_BYOK=false

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=
ENCRYPTION_SECRET=

# People Data Labs (Find Client Leads)
PDL_API_KEY=
# Optional: override the PDL API base URL (defaults to https://api.peopledatalabs.com/v5)
PDL_BASE_URL=

# Apify Setup (job & person search only — client leads now use People Data Labs)
APIFY_API_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR=
APIFY_INDEED_JOBS_ACTOR=
APIFY_GOOGLE_JOBS_ACTOR=
APIFY_REMOTE_JOBS_ACTOR=
APIFY_WORLD_JOBS_ACTOR=

# OpenRouter (AI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# NeverBounce (email verification) — required when IS_BYOK=false
NEVERBOUNCE_API_KEY=

# Twilio (SMS Outreach)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP (Email Outreach)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# App Defaults
EMAIL_DAILY_LIMIT=
EMAIL_SEND_DELAY_SECONDS=
DEFAULT_BOOKING_LINK=

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Calendly OAuth
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3000/api/integrations/calendly/callback

# Apify Configuration
APIFY_API_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR=
APIFY_INDEED_JOBS_ACTOR=
APIFY_GOOGLE_JOBS_ACTOR=
APIFY_REMOTE_JOBS_ACTOR=
APIFY_WORLD_JOBS_ACTOR=
# Job Search Configuration
JOB_SEARCH_DAILY_LIMIT=100
AI_JOB_ANALYSIS_BATCH_SIZE=10
MAX_RESUME_FILE_SIZE_MB=30

# Optional Apify Actor for enriching email and phone
PERSON_CONTACT_ENRICHMENT_ACTOR_ID=
