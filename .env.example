# Database Setup
DATABASE_URL=

# Authentication & Security
# true = users must supply OpenRouter, NeverBounce, Apify, BayOfAssets, PDL,
#        Resend and Twilio keys in Settings → API Keys instead of these env vars
IS_BYOK=false

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=
ENCRYPTION_SECRET=

# People Data Labs (Find Client Leads)
PDL_API_KEY=
# Optional: override the PDL API base URL (defaults to https://api.peopledatalabs.com/v5)
PDL_BASE_URL=

# Apify Setup (job & person search only — client leads now use People Data Labs)
APIFY_API_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR=
APIFY_INDEED_JOBS_ACTOR=
APIFY_GOOGLE_JOBS_ACTOR=
APIFY_REMOTE_JOBS_ACTOR=
APIFY_WORLD_JOBS_ACTOR=

# OpenRouter (AI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# NeverBounce (email verification) — required when IS_BYOK=false
NEVERBOUNCE_API_KEY=

# Twilio (SMS Outreach)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP (Email Outreach)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# App Defaults
EMAIL_DAILY_LIMIT=
EMAIL_SEND_DELAY_SECONDS=
DEFAULT_BOOKING_LINK=

# Resend (campaign email sending) — required when IS_BYOK=false.
# One account-level key for all campaigns; each campaign only picks the verified
# sender address it sends from. When IS_BYOK=true this is ignored and users add
# their own key in Settings → API Keys.
RESEND_API_KEY=
# System from-address for auth emails (forgot password). Must be allowed by Resend.
RESEND_MAIL_FROM=

# Replies: captured via a Resend webhook the app auto-creates when the key is
# saved / a campaign sender is set. NEXT_PUBLIC_APP_URL must be public (ngrok in
# local dev), and the domain needs its receiving MX record from the Resend
# Domains page. Set this only if you created the webhook in Resend manually.
RESEND_WEBHOOK_SECRET=

# Calendly OAuth
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3000/api/integrations/calendly/callback

# Apify Configuration
APIFY_API_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR=
APIFY_INDEED_JOBS_ACTOR=
APIFY_GOOGLE_JOBS_ACTOR=
APIFY_REMOTE_JOBS_ACTOR=
APIFY_WORLD_JOBS_ACTOR=
# Job Search Configuration
JOB_SEARCH_DAILY_LIMIT=100
AI_JOB_ANALYSIS_BATCH_SIZE=10
MAX_RESUME_FILE_SIZE_MB=30

# Optional Apify Actor for enriching email and phone
PERSON_CONTACT_ENRICHMENT_ACTOR_ID=

# Background email scheduler — runs inside the app (instrumentation.ts) on a
# dedicated server like Railway. No external cron needed.
SCHEDULER_INTERVAL_MINUTES=10
DISABLE_BACKGROUND_SCHEDULER=false

# Optional: protects manual/external trigger endpoints under /api/cron/*
CRON_SECRET=
